# ============================================================
# Assistente Inteligente do IFCE Campus Maranguape
# Copie este arquivo para  backend/.env  e ajuste os valores.
# ============================================================

# --- Google AI Studio (endpoint compativel com OpenAI) ---
# Para projetos sem acesso ao 2.5 Flash, use gemini-3.5-flash-lite.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-2.5-flash
LLM_API_KEY=COLE_SUA_CHAVE_AQUI
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=900
LLM_TIMEOUT=120

# --- Embeddings (roda local, gratuito) ---
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_QUERY_PREFIX=query:
EMBEDDING_PASSAGE_PREFIX=passage:

# --- Recuperacao ---
CHUNK_SIZE=900
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.30

# --- Caminhos ---
DOCUMENTS_DIR=data/documentos
CHROMA_DIR=data/chroma
LOGS_DIR=data/logs
COLLECTION_NAME=ifce_maranguape

# --- API ---
CORS_ORIGINS=*
ADMIN_TOKEN=troque-este-token
