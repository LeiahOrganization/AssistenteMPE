# ============================================================
# Assistente Inteligente do IFCE Campus Maranguape
# Copie este arquivo para  backend/.env  e ajuste os valores.
# ============================================================

# --- LLM gratuito (endpoint compativel com OpenAI) ---
# Opcao A - Groq (sem ngrok, chave gratuita em console.groq.com/keys):
#   LLM_BASE_URL=https://api.groq.com/openai/v1
#   LLM_API_KEY=gsk_...
# Opcao B - modelo proprio servido por vLLM/Ollama e exposto pelo ngrok:
# Ex.: vLLM / llama.cpp / LM Studio / Ollama rodando em GPU e exposto pelo ngrok.
# IMPORTANTE: a URL precisa terminar em /v1
LLM_BASE_URL=https://SEU-SUBDOMINIO.ngrok-free.app/v1
LLM_MODEL=openai/gpt-oss-20b
LLM_API_KEY=nao-usada-mas-obrigatoria
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=900
LLM_TIMEOUT=120

# --- Embeddings (roda local, gratuito) ---
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_QUERY_PREFIX=query:
EMBEDDING_PASSAGE_PREFIX=passage:

# --- Recuperacao ---
CHUNK_SIZE=900
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.30

# --- Caminhos ---
DOCUMENTS_DIR=data/documentos
CHROMA_DIR=data/chroma
LOGS_DIR=data/logs
COLLECTION_NAME=ifce_maranguape

# --- API ---
CORS_ORIGINS=*
ADMIN_TOKEN=troque-este-token
